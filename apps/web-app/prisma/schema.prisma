generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  location      String?
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts Account[]
  sessions Session[]
  friends  Friend[]
  trips    Trip[]
}

model Friend {
  id            String       @id @default(cuid())
  name          String
  location      String
  latitude      Float
  longitude     Float
  userId        String
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trip {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  userId    String
  routes    Route[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Route {
  id           String        @id @default(cuid())
  name         String
  tripId       String
  destinations Destination[]
  trip         Trip          @relation(fields: [tripId], references: [id])
}

model Destination {
  id        String   @id @default(cuid())
  location  String
  latitude  Float
  longitude Float
  order     Int
  routeId   String
  startDate DateTime
  endDate   DateTime
  route     Route    @relation(fields: [routeId], references: [id])
  friends   Friend[]
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}